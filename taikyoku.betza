export :center master: = sW3 bF3 vD fA vR fB;

export :peng master: = sW5 bF5 fG vR fB;

export :free eagle: =
        Q                       # slider
        (D A H G f:4,4: - [Q])  # leap and slide
        (cmK - bK)              # igui + jitto
        (cmK-[cm3] - [Q])         # sweep capture
        f(cmF-[cm4] - [Q]);       # sweep capture (forward diagonal)

export :free bird: =
        R fB bF3           # slider
        f((jyB-[jy3]) - B);  # slide and jump

export :great hawk: = Q f(jyR - R);

export :king of teachings: = Q ((jyQ-[jy3]) - Q);

export :mountain crane: = Q ((jyQ-[jy3]) - Q);

export :great eagle: = Q f(jyB - B);

export :great elephant: =
        fF3 R bB
        ((jyR-[jy3]) - R)
        b((jyB-[jy3]) - B);

export :gold bird: = sW3 bF3 vR fB f((jyB-[jy3]) - B);

export :ancient dragon: =
        B vR
        v((jyR-[jy3]) - R);

export :rain demon: =
        fW3 sW2 bF2 bR fB
        f(jyB - B);

export :flying general: = cymW-[cym0];

export :angle general: = cymF-[cym0];

export :great general: = cymK-[cym0];

export :fierce dragon: = :angle general: W2;

export :flying crocodile: = :flying general: bF2 fF3;

export :vice general: = :angle general: D;

export :hook mover: = R - [sR];

export :tengu: = B - [sB];

export :capricorn: = :tengu: W;

export :peacock: = f:tengu: bF2;

export :heavenly tetrarch king: = Q (jyQ - Q);

export :lion: = D A N (cmK - [aK]);

export :furious fiend: = :lion: W3 F3;

export :buddhist spirit: = :lion: Q;

export :lion hawk: = :lion: B;
