###############################################################################
# LEAPERS, JUMPERS, & SPECIAL
###############################################################################

# On `j` in this section.
#
# Sekai no Shogi (Umebayashi, 1997) marks several pieces with glyphs
# that en.wikipedia renders as leaps to a fixed square. The primary
# source does not support that reading.
#
# Sourced. Rule 4 (p. 235) gives a possible explanation to the hatched arrow:
# while the original text gives none and the meaning is unclear, it is said
# that arrows with three strokes are 思われる ("thought") to allow
# crossing up to three PIECES and then ranging. The count is of pieces,
# not squares. Applies to: king of teachings, free bird, gold bird,
# great elephant, ancient dragon.
#
# Sourced. Four pieces carry a circle superimposed on a ranging arrow
# and are detailed in prose as 駒を飛び越えて走りが出来る ("can jump
# over piece(s) and range"): heavenly tetrarch king (all eight
# directions), great hawk (forward only), rain demon and great eagle
# (forward diagonals). One circle, one hurdle.
#
# Inferred. The treacherous fox draws TWO circles on its arrows and
# the mountain crane a numeral 3, both using the same superimposition
# but without any attached prose. We read the marker count as the hurdle
# allowance, by analogy with rule 4's compression of strokes. This is
# our inference, not Umebayashi's; ja.wikipedia instead concluded
# these two pieces have no special jumping power. Supporting: the
# fox's circles sit at distances 1 and 2, so the leap reading would
# make one of them a plain step, and en.wikipedia silently shifts
# them to 2 and 3 to compensate. Also, fox (2 hurdles, 6 directions)
# promoting to crane (3 hurdles, 8 directions) is a monotone upgrade,
# as opposed to the leap reading which has the piece change mechanism
# on promotion.
#
# Pieces with a plain × or 3× glyph ARE genuine leaps per the p. 210
# legend and are left as leapers: great master, lion dog, the
# turtles, phoenix/kirin masters, flying cat, cassia horse, flying
# dragon, phoenix, kirin, running horse, mountain hawk, great stag,
# the mountain eagles, horned hawk, flying eagle, roaring dog, great
# dream-eater, heavenly horse, center master, peng master, vice
# general.
#
# Note that en.wikipedia's own footnote [k] quotes rule 4 and renders
# 駒 as "pieces [squares]" — the bracketed interpretation is editorial,
# where the Japanese is unambiguous.

export :treacherous fox: =
        B vR  # slider
# Reading A (en.wikipedia): leap to distance 2 or 3, then slide.
#         (AG - [B])    # leap and slide (diagonal)
#         v(DH - [R]);  # leap and slide (orthogonal)
# Reading B (inferred from Sekai no Shogi glyph conventions): cross
# up to 2 hurdles at any distance, then continue ranging.
        v((jyQ-[jy2]) - Q);
# Reading B chosen — consistent with rule 4's piece-counting, with
# the four circle-on-arrow pieces, and with the promotion
# to mountain crane (3 hurdles, 8 dirs).

export :cassia horse: = <ff>N;

export :flying dragon: = A;

export :kirin: = F vW sD;

export :phoenix: = W A;

export :flying cat: = bK fsH fG;

export :running horse: = bW bA fQ;

export :mountain hawk: = fD R fB bF2;

export :little turtle: = vD vQ sW2;

export :great stag: = fA R bF2;

export :left mountain eagle: = lA R flB <br>F2;

export :right mountain eagle: = rA R frB <bl>F2;

export :kirin master: = vH vQ sW3;
export :great turtle: = :kirin master:;

export :phoenix master: = vQ fG sW3;

export :great master: = fG fH bF5 sW5 fQ bR;

export :horned hawk: = Q fD;

export :flying eagle: = Q fA;

export :roaring dog: = fG H R fB bF3;

export :lion dog: = Q H G;

export :great dream eater: = Q sH;

